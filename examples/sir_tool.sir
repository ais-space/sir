                    Op: Core.ListPush
                    Params: lines, sterm
                    Returns: lines

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Gt
                    Params: si, zero
                    Returns: sicont

        Instruction
            Type: Instruction
            Role: Content
            Caption: Single-pass join of diff lines
            Op: Core.StrJoinParts
            Params: lines
            Returns: out

        Result
            Type: Result
            Role: Content
            Caption: Unified diff preview
            State: Ok
            Returns: out
