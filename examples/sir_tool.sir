                    Op: Core.Lit
                    Params: "Capabilities"
                    Returns: capLit

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Capabilities merges separately
                    Op: Core.Eq
                    Params: key, capLit
                    Returns: isCap

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Copy or skip the key
                    Condition: isCap

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Lines unchanged past Capabilities
                            Op: Core.Id
                            Params: lines
                            Returns: lines

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the value under this key
                            Op: Core.MapGet
                            Params: props, key
                            Returns: val

