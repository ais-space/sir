                    Role: Content
                    Caption: Advance the function cursor
                    Op: Core.Add
                    Params: fi, 1
                    Returns: fi

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: fi, flen
                    Returns: fcont

