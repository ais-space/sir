                            Caption: Render the program property line
                            Op: Ctrl.Call
                            Params: FmtPropLine, indProp, key, val, nl
                            Returns: pline

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Keep the program property line
                            Op: Core.ListPush
                            Params: lines, pline
                            Returns: lines

                Instruction
