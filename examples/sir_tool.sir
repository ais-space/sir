            Role: Content
            Caption: Props key literal
            Op: Core.Lit
            Params: "props"
            Returns: propsKey

        Instruction
            Type: Instruction
            Role: Content
            Caption: Store the arm props
            Op: Core.MapSet
            Params: arm, propsKey, tprops
            Returns: arm

        Instruction
            Type: Instruction
            Role: Content
            Caption: Children key literal
            Op: Core.Lit
            Params: "children"
            Returns: kidsKey

        Instruction
            Type: Instruction
            Role: Content
            Caption: Store the wrapped range
            Op: Core.MapSet
            Params: arm, kidsKey, nodes
            Returns: arm

        Instruction
            Type: Instruction
            Role: Content
            Caption: Branch node carries the arm
            Op: Core.Map
            Returns: branch

        Instruction
            Type: Instruction
            Role: Content
            Caption: Store the branch name
            Op: Core.MapSet
            Params: branch, nameKey, branchLit
            Returns: branch

        Instruction
            Type: Instruction
            Role: Content
            Caption: Store the branch props
            Op: Core.MapSet
            Params: branch, propsKey, props
