                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Splice one range item out
                    Op: Ctrl.Call
                    Params: EditSplice, kids, from, nofrags, delmode
                    Returns: kids

