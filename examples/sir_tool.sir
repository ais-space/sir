                    Role: Content
                    Caption: Advance the key cursor
                    Op: Core.Add
                    Params: ki, 1
                    Returns: ki

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: ki, klen
                    Returns: kcont

        Instruction
            Type: Instruction
            Role: Content
