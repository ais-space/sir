Context
    DocumentVersion: 0.11.1-draft
    GrammarVersion: 1.0.1

Module
    Type: Module
    Role: Content
    Caption: SirTool - canonical SIR formatter and structural editor
    Capabilities: Sys.Input, Sys.Output, Sys.Storage
    Include
        Path: ../../../sir_compiler_workbench/pre_repo/modules/Parse/Parse.sir
        Module: Parse
    Include
        Path: ../../../sir_compiler_workbench/pre_repo/modules/SirGate/SirGate.sir
        Module: SirGate
    Include
        Path: ../../../sir_compiler_workbench/pre_repo/modules/PopWhile/PopWhile.sir
        Module: PopWhile
    Include
        Path: ../../../sir_compiler_workbench/pre_repo/modules/Slice/Slice.sir
        Module: Slice
    Include
        Path: ../../../sir_compiler_workbench/pre_repo/modules/TopDepth/TopDepth.sir
        Module: TopDepth
    Include
        Path: ../../../sir_compiler_workbench/pre_repo/modules/TopIdx/TopIdx.sir
        Module: TopIdx

    Function
        Type: Function
        Role: Content
        Name: FmtIndent
        Params: depth
        Returns: ind

        Instruction
            Type: Instruction
            Role: Content
            Caption: Indent parts accumulate here
            Op: Core.List
            Returns: parts

        Instruction
            Type: Instruction
            Role: Content
            Caption: Wide space unit per level
            Op: Core.Lit
            Params: "    "
            Returns: unit

        Instruction
            Type: Instruction
            Role: Content
            Caption: Level counter starts at zero
            Op: Core.Lit
            Params: 0
            Returns: i

        Instruction
            Type: Instruction
            Role: Content
            Caption: Enter while levels remain
            Op: Core.Lt
            Params: i, depth
            Returns: cont

        Loop
            Type: Loop
            Role: Content
            Caption: Push one unit per depth level
            Condition: cont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Keep one more indent unit
                    Op: Core.ListPush
                    Params: parts, unit
                    Returns: parts

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Advance the level counter
                    Op: Core.Add
                    Params: i, 1
                    Returns: i

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: i, depth
                    Returns: cont

        Instruction
            Type: Instruction
            Role: Content
            Caption: Single-pass join of indent units
            Op: Core.StrJoinParts
            Params: parts
            Returns: ind

        Result
            Type: Result
            Role: Content
            Caption: Indent string for this depth
            State: Ok
            Returns: ind

    Function
        Type: Function
        Role: Content
        Name: FmtPropLine
        Params: indProp, key, val, nl
        Returns: pline

        Instruction
            Type: Instruction
            Role: Content
            Caption: Runtime type of the value selects rendering
            Op: Core.TypeOf
            Params: val
            Returns: vt

        Instruction
            Type: Instruction
            Role: Content
            Caption: String tag literal
            Op: Core.Lit
            Params: "str"
            Returns: strTag

        Instruction
            Type: Instruction
            Role: Content
            Caption: Text values render verbatim
            Op: Core.Eq
            Params: vt, strTag
            Returns: isStr

        Instruction
            Type: Instruction
            Role: Content
            Caption: Int tag literal
            Op: Core.Lit
            Params: "int"
            Returns: intTag

        Instruction
            Type: Instruction
            Role: Content
            Caption: Integers render via NumToStr
            Op: Core.Eq
            Params: vt, intTag
            Returns: isInt

        Branch
            Type: Branch
            Role: Content
            Caption: Verbatim or converted text
            Condition: isStr

            TrueBlock
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Text value stays verbatim
                    Op: Core.Id
                    Params: val
                    Returns: vtext

            FalseBlock
                Type: Section
                Role: Content

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Integer or boolean text
                    Condition: isInt

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Integer value as text
                            Op: Core.NumToStr
                            Params: val
                            Returns: vtext

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: True literal for the boolean test
                            Op: Core.Lit
                            Params: true
                            Returns: tru

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Boolean value under test
                            Op: Core.Eq
                            Params: val, tru
                            Returns: isTrue

                        Branch
                            Type: Branch
                            Role: Content
                            Caption: True text or false text
                            Condition: isTrue

                            TrueBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: True renders as true text
                                    Op: Core.Lit
                                    Params: "true"
                                    Returns: vtext

                            FalseBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Anything else renders as false text
                                    Op: Core.Lit
                                    Params: "false"
                                    Returns: vtext

        Instruction
            Type: Instruction
            Role: Content
            Caption: Separator between key and value
            Op: Core.Lit
            Params: ": "
            Returns: sep

        Instruction
            Type: Instruction
            Role: Content
            Caption: Canonical property line with newline
            Op: Core.StrConcat
            Params: indProp, key, sep, vtext, nl
            Returns: pline

        Result
            Type: Result
            Role: Content
            Caption: Finished property line
            State: Ok
            Returns: pline

    Function
        Type: Function
        Role: Content
        Name: FmtNode
        Params: node, depth, nl, lines
        Returns: lines

        Instruction
            Type: Instruction
            Role: Content
            Caption: Indent for the node name line
            Op: Ctrl.Call
            Params: FmtIndent, depth
            Returns: ind

        Instruction
            Type: Instruction
            Role: Content
            Caption: Node name heads its block
            Op: Core.MapGet
            Params: node, "name"
            Returns: name

        Instruction
            Type: Instruction
            Role: Content
            Caption: Canonical name line with newline
            Op: Core.StrConcat
            Params: ind, name, nl
            Returns: nameline

        Instruction
            Type: Instruction
            Role: Content
            Caption: Keep the name line
            Op: Core.ListPush
            Params: lines, nameline
            Returns: lines

        Instruction
            Type: Instruction
            Role: Content
            Caption: Property indent nests one level deeper
            Op: Core.Lit
            Params: "    "
            Returns: unit

        Instruction
            Type: Instruction
            Role: Content
            Caption: Join node indent with one more unit
            Op: Core.StrConcat
            Params: ind, unit
            Returns: indProp

        Instruction
            Type: Instruction
            Role: Content
            Caption: Property map of this node
            Op: Core.MapGet
            Params: node, "props"
            Returns: props

        Instruction
            Type: Instruction
            Role: Content
            Caption: Canonical key order for determinism
            Op: Core.MapKeys
            Params: props
            Returns: keys

        Instruction
            Type: Instruction
            Role: Content
            Caption: Key count bounds the scan
            Op: Core.ListLen
            Params: keys
            Returns: klen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Key cursor starts at zero
            Op: Core.Lit
            Params: 0
            Returns: ki

        Instruction
            Type: Instruction
            Role: Content
            Caption: Enter while keys remain
            Op: Core.Lt
            Params: ki, klen
            Returns: kcont

        Loop
            Type: Loop
            Role: Content
            Caption: Emit one line per property key
            Condition: kcont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the current key
                    Op: Core.ListGet
                    Params: keys, ki
                    Returns: key

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the value under this key
                    Op: Core.MapGet
                    Params: props, key
                    Returns: val

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Render the canonical property line
                    Op: Ctrl.Call
                    Params: FmtPropLine, indProp, key, val, nl
                    Returns: pline

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Keep the property line
                    Op: Core.ListPush
                    Params: lines, pline
                    Returns: lines

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Advance the key cursor
                    Op: Core.Add
                    Params: ki, 1
                    Returns: ki

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: ki, klen
                    Returns: kcont

        Instruction
            Type: Instruction
            Role: Content
            Caption: Child list of this node
            Op: Core.MapGet
            Params: node, "children"
            Returns: children

        Instruction
            Type: Instruction
            Role: Content
            Caption: Child count bounds the scan
            Op: Core.ListLen
            Params: children
            Returns: clen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Child cursor starts at zero
            Op: Core.Lit
            Params: 0
            Returns: ci

        Instruction
            Type: Instruction
            Role: Content
            Caption: One level literal for the recursion
            Op: Core.Lit
            Params: 1
            Returns: one

        Instruction
            Type: Instruction
            Role: Content
            Caption: Enter while children remain
            Op: Core.Lt
            Params: ci, clen
            Returns: ccont

        Loop
            Type: Loop
            Role: Content
            Caption: Serialize each child one level deeper
            Condition: ccont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the current child
                    Op: Core.ListGet
                    Params: children, ci
                    Returns: ch

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Child depth nests one level deeper
                    Op: Core.Add
                    Params: depth, one
                    Returns: cdepth

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Recurse into the child subtree
                    Op: Ctrl.Call
                    Params: FmtNode, ch, cdepth, nl, lines
                    Returns: lines

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Advance the child cursor
                    Op: Core.Add
                    Params: ci, 1
                    Returns: ci

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: ci, clen
                    Returns: ccont

        Result
            Type: Result
            Role: Content
            Caption: Accumulated lines of this subtree
            State: Ok
            Returns: lines

    Function
        Type: Function
        Role: Content
        Name: FmtDoc
        Params: src
        Returns: out

        Instruction
            Type: Instruction
            Role: Content
            Caption: Version gate refuses newer-than-supported SIR loudly
            Op: Ctrl.Call
            Params: SirGate, src
            Returns: gated

        Instruction
            Type: Instruction
            Role: Content
            Caption: Parse the gated source into a node tree
            Op: Ctrl.Call
            Params: Parse, gated
            Returns: ast

        Instruction
            Type: Instruction
            Role: Content
            Caption: Top-level blocks of the document
            Op: Core.MapGet
            Params: ast, "children"
            Returns: children

        Instruction
            Type: Instruction
            Role: Content
            Caption: Canonical lines accumulate here
            Op: Core.List
            Returns: lines

        Instruction
            Type: Instruction
            Role: Content
            Caption: Line separator for canonical output
            Op: Core.Chr
            Params: 10
            Returns: nl

        Instruction
            Type: Instruction
            Role: Content
            Caption: Top-level depth is zero
            Op: Core.Lit
            Params: 0
            Returns: zero

        Instruction
            Type: Instruction
            Role: Content
            Caption: Block count bounds the scan
            Op: Core.ListLen
            Params: children
            Returns: clen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Block cursor starts at zero
            Op: Core.Lit
            Params: 0
            Returns: ci

        Instruction
            Type: Instruction
            Role: Content
            Caption: Enter while blocks remain
            Op: Core.Lt
            Params: ci, clen
            Returns: ccont

        Loop
            Type: Loop
            Role: Content
            Caption: Serialize each top-level block
            Condition: ccont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the current block
                    Op: Core.ListGet
                    Params: children, ci
                    Returns: ch

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Serialize the block subtree
                    Op: Ctrl.Call
                    Params: FmtNode, ch, zero, nl, lines
                    Returns: lines

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Advance the block cursor
                    Op: Core.Add
                    Params: ci, 1
                    Returns: ci

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: ci, clen
                    Returns: ccont

        Instruction
            Type: Instruction
            Role: Content
            Caption: Single-pass join of canonical lines
            Op: Core.StrJoinParts
            Params: lines
            Returns: out

        Result
            Type: Result
            Role: Content
            Caption: Canonical document text
            State: Ok
            Returns: out

    Function
        Type: Function
        Role: Content
        Name: main
        Returns: out

        Instruction
            Type: Instruction
            Role: Content
            Caption: Raw stdin carries mode prefix plus document
            Op: Sys.Input
            Params: src
            Returns: raw

        Instruction
            Type: Instruction
            Role: Content
            Caption: Formatter mode word
            Op: Core.Lit
            Params: "fmt"
            Returns: fmtBase

        Instruction
            Type: Instruction
            Role: Content
            Caption: Line separator for the mode prefix
            Op: Core.Chr
            Params: 10
            Returns: nl

        Instruction
            Type: Instruction
            Role: Content
            Caption: Expected mode prefix with newline
            Op: Core.StrConcat
            Params: fmtBase, nl
            Returns: fmtLit

        Instruction
            Type: Instruction
            Role: Content
            Caption: Prefix length is mode word plus newline
            Op: Core.Lit
            Params: 4
            Returns: fmtLen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Expander prefix length bound on all paths
            Op: Core.Lit
            Params: 7
            Returns: expLen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Insert prefix length bound on all paths
            Op: Core.Lit
            Params: 7
            Returns: insLen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Replace prefix length bound on all paths
            Op: Core.Lit
            Params: 8
            Returns: repLen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Delete prefix length bound on all paths
            Op: Core.Lit
            Params: 7
            Returns: delLen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Move prefix length bound on all paths
            Op: Core.Lit
            Params: 5
            Returns: movLen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Wrap prefix length bound on all paths
            Op: Core.Lit
            Params: 5
            Returns: wrpLen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Diff prefix length bound on all paths
            Op: Core.Lit
            Params: 5
            Returns: difLen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Raw length guards the prefix read
            Op: Core.StrLen
            Params: raw
            Returns: rawLen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Long enough to carry the prefix
            Op: Core.Ge
            Params: rawLen, fmtLen
            Returns: hasLen

        Branch
            Type: Branch
            Role: Content
            Caption: Prefix read or short-input refusal
            Condition: hasLen

            TrueBlock
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the candidate prefix
                    Op: Core.StrSub
                    Params: raw, 0, fmtLen
                    Returns: prefix

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Prefix match selects the formatter
                    Op: Core.Eq
                    Params: prefix, fmtLit
                    Returns: isFmt

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Expander mode word
                    Op: Core.Lit
                    Params: "expand"
                    Returns: expBase

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Expected expander prefix with newline
                    Op: Core.StrConcat
                    Params: expBase, nl
                    Returns: expLit

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Long enough to carry the expander prefix
                    Op: Core.Ge
                    Params: rawLen, expLen
                    Returns: hasExpLen

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Expander prefix read or short refusal
                    Condition: hasExpLen

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the candidate expander prefix
                            Op: Core.StrSub
                            Params: raw, 0, expLen
                            Returns: expprefix

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Prefix match selects the expander
                            Op: Core.Eq
                            Params: expprefix, expLit
                            Returns: isExpand

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Too short to be an expander call
                            Op: Core.Lit
                            Params: false
                            Returns: isExpand

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Insert mode word
                    Op: Core.Lit
                    Params: "insert"
                    Returns: insBase

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Expected insert prefix with newline
                    Op: Core.StrConcat
                    Params: insBase, nl
                    Returns: insLit

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Long enough to carry the insert prefix
                    Op: Core.Ge
                    Params: rawLen, insLen
                    Returns: hasInsLen

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Replace mode word
                    Op: Core.Lit
                    Params: "replace"
                    Returns: repBase

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Expected replace prefix with newline
                    Op: Core.StrConcat
                    Params: repBase, nl
                    Returns: repLit

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Long enough to carry the replace prefix
                    Op: Core.Ge
                    Params: rawLen, repLen
                    Returns: hasRepLen

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Delete mode word
                    Op: Core.Lit
                    Params: "delete"
                    Returns: delBase

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Expected delete prefix with newline
                    Op: Core.StrConcat
                    Params: delBase, nl
                    Returns: delLit

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Long enough to carry the delete prefix
                    Op: Core.Ge
                    Params: rawLen, delLen
                    Returns: hasDelLen

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Insert prefix read or short refusal
                    Condition: hasInsLen

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the candidate insert prefix
                            Op: Core.StrSub
                            Params: raw, 0, insLen
                            Returns: insprefix

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Prefix match selects insert
                            Op: Core.Eq
                            Params: insprefix, insLit
                            Returns: isIns

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Too short to be an insert call
                            Op: Core.Lit
                            Params: false
                            Returns: isIns

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Replace prefix read or short refusal
                    Condition: hasRepLen

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the candidate replace prefix
                            Op: Core.StrSub
                            Params: raw, 0, repLen
                            Returns: repprefix

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Prefix match selects replace
                            Op: Core.Eq
                            Params: repprefix, repLit
                            Returns: isRep

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Too short to be a replace call
                            Op: Core.Lit
                            Params: false
                            Returns: isRep

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Delete prefix read or short refusal
                    Condition: hasDelLen

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the candidate delete prefix
                            Op: Core.StrSub
                            Params: raw, 0, delLen
                            Returns: delprefix

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Prefix match selects delete
                            Op: Core.Eq
                            Params: delprefix, delLit
                            Returns: isDel

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Too short to be a delete call
                            Op: Core.Lit
                            Params: false
                            Returns: isDel

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Move mode word
                    Op: Core.Lit
                    Params: "move"
                    Returns: movBase

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Expected move prefix with newline
                    Op: Core.StrConcat
                    Params: movBase, nl
                    Returns: movLit

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Long enough to carry the move prefix
                    Op: Core.Ge
                    Params: rawLen, movLen
                    Returns: hasMovLen

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Wrap mode word
                    Op: Core.Lit
                    Params: "wrap"
                    Returns: wrpBase

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Expected wrap prefix with newline
                    Op: Core.StrConcat
                    Params: wrpBase, nl
                    Returns: wrpLit

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Long enough to carry the wrap prefix
                    Op: Core.Ge
                    Params: rawLen, wrpLen
                    Returns: hasWrpLen

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Move prefix read or short refusal
                    Condition: hasMovLen

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the candidate move prefix
                            Op: Core.StrSub
                            Params: raw, 0, movLen
                            Returns: movprefix

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Prefix match selects move
                            Op: Core.Eq
                            Params: movprefix, movLit
                            Returns: isMove

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Too short to be a move call
                            Op: Core.Lit
                            Params: false
                            Returns: isMove

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Wrap prefix read or short refusal
                    Condition: hasWrpLen

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the candidate wrap prefix
                            Op: Core.StrSub
                            Params: raw, 0, wrpLen
                            Returns: wrpprefix

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Prefix match selects wrap
                            Op: Core.Eq
                            Params: wrpprefix, wrpLit
                            Returns: isWrap

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Too short to be a wrap call
                            Op: Core.Lit
                            Params: false
                            Returns: isWrap

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Diff mode word
                    Op: Core.Lit
                    Params: "diff"
                    Returns: difBase

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Expected diff prefix with newline
                    Op: Core.StrConcat
                    Params: difBase, nl
                    Returns: difLit

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Long enough to carry the diff prefix
                    Op: Core.Ge
                    Params: rawLen, difLen
                    Returns: hasDifLen

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Diff prefix read or short refusal
                    Condition: hasDifLen

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the candidate diff prefix
                            Op: Core.StrSub
                            Params: raw, 0, difLen
                            Returns: difprefix

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Prefix match selects diff
                            Op: Core.Eq
                            Params: difprefix, difLit
                            Returns: isDiff

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Too short to be a diff call
                            Op: Core.Lit
                            Params: false
                            Returns: isDiff

            FalseBlock
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Too short to be a formatter call
                    Op: Core.Lit
                    Params: false
                    Returns: isFmt

                Instruction
