    Function
        Type: Function
        Role: Content
        Name: EditDiff
        Params: oldText, newText
        Returns: out

        Instruction
            Type: Instruction
            Role: Content
            Caption: Line separator for the line split
            Op: Core.Chr
            Params: 10
            Returns: nl

        Instruction
            Type: Instruction
            Role: Content
            Caption: Split the old text into lines
            Op: Core.StrSplit
            Params: oldText, nl
            Returns: rawOlds

        Instruction
            Type: Instruction
            Role: Content
            Caption: Split the new text into lines
            Op: Core.StrSplit
            Params: newText, nl
            Returns: rawNews

        Instruction
            Type: Instruction
            Role: Content
            Caption: Zero literal for the empty test
            Op: Core.Lit
            Params: 0
            Returns: zero

        Instruction
            Type: Instruction
            Role: Content
            Caption: One literal for the slot math
            Op: Core.Lit
            Params: 1
            Returns: one

        Instruction
            Type: Instruction
            Role: Content
            Caption: Empty via zero-width slice of the separator
            Op: Core.StrSub
            Params: nl, zero, zero
            Returns: mt

        Instruction
            Type: Instruction
            Role: Content
            Caption: Old lines start raw
            Op: Core.Id
            Params: rawOlds
            Returns: olds

        Instruction
            Type: Instruction
            Role: Content
            Caption: Terminal splits drop while empty
            Op: Core.Lit
            Params: true
            Returns: ocont

        Loop
            Type: Loop
            Role: Content
            Caption: Drop every terminal split of old text
            Condition: ocont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Old length guards the peek
                    Op: Core.ListLen
                    Params: olds
                    Returns: curlen

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Old text keeps one line at least
                    Op: Core.Gt
                    Params: curlen, zero
                    Returns: nonempty

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Peek or stop the trim
                    Condition: nonempty

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Last old slot may carry a split
                            Op: Core.Sub
                            Params: curlen, one
                            Returns: lastpos

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the last old line
                            Op: Core.ListGet
                            Params: olds, lastpos
                            Returns: lastline

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Terminal split at the old end
                            Op: Core.Eq
                            Params: lastline, mt
                            Returns: isTerm

                        Branch
                            Type: Branch
                            Role: Content
                            Caption: Cut or stop the trim
                            Condition: isTerm

                            TrueBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Cut the terminal split
                                    Op: Ctrl.Call
                                    Params: EditTakeLines, olds, zero, lastpos
                                    Returns: olds

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Keep trimming the old end
                                    Op: Core.Id
                                    Params: ocont
                                    Returns: ocont

                            FalseBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Content stops the old trim
                                    Op: Core.Lit
                                    Params: false
                                    Returns: ocont

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Empty old text stops the trim
                            Op: Core.Lit
                            Params: false
                            Returns: ocont

        Instruction
            Type: Instruction
            Role: Content
            Caption: New lines start raw
            Op: Core.Id
            Params: rawNews
            Returns: news

        Instruction
            Type: Instruction
            Role: Content
            Caption: Terminal splits drop while empty
            Op: Core.Lit
            Params: true
            Returns: ncont

        Loop
            Type: Loop
            Role: Content
            Caption: Drop every terminal split of new text
            Condition: ncont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: New length guards the peek
                    Op: Core.ListLen
                    Params: news
                    Returns: ncurlen

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: New text keeps one line at least
                    Op: Core.Gt
                    Params: ncurlen, zero
                    Returns: nnonempty

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Peek or stop the trim
                    Condition: nnonempty

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Last new slot may carry a split
                            Op: Core.Sub
                            Params: ncurlen, one
                            Returns: nlastpos

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the last new line
                            Op: Core.ListGet
                            Params: news, nlastpos
                            Returns: nlastline

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Terminal split at the new end
                            Op: Core.Eq
                            Params: nlastline, mt
                            Returns: nisTerm

                        Branch
                            Type: Branch
                            Role: Content
                            Caption: Cut or stop the trim
                            Condition: nisTerm

                            TrueBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Cut the terminal split
                                    Op: Ctrl.Call
                                    Params: EditTakeLines, news, zero, nlastpos
                                    Returns: news

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Keep trimming the new end
                                    Op: Core.Id
                                    Params: ncont
                                    Returns: ncont

                            FalseBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Content stops the new trim
                                    Op: Core.Lit
                                    Params: false
                                    Returns: ncont

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Empty new text stops the trim
                            Op: Core.Lit
                            Params: false
                            Returns: ncont

            FalseBlock
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: New lines stay whole
                    Op: Core.Id
                    Params: rawNews
                    Returns: news

        Instruction
            Type: Instruction
            Role: Content
            Caption: Old length bounds the prefix
            Op: Core.ListLen
            Params: olds
            Returns: olen

        Instruction
            Type: Instruction
            Role: Content
            Caption: New length bounds the prefix
            Op: Core.ListLen
            Params: news
