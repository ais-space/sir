        Instruction
            Type: Instruction
            Role: Content
            Caption: Content role literal
            Op: Core.Lit
            Params: "Content"
            Returns: contentRole

        Instruction
            Type: Instruction
            Role: Content
            Caption: Store the content role
            Op: Core.MapSet
            Params: props, roleKey, contentRole
            Returns: props

        Instruction
            Type: Instruction
            Role: Content
            Caption: TrueBlock name literal
            Op: Core.Lit
            Params: "TrueBlock"
