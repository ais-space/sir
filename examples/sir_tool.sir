        Loop
            Type: Loop
            Role: Content
            Caption: Descend to the range parent
            Condition: scont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the current segment
                    Op: Core.ListGet
                    Params: segs, si
