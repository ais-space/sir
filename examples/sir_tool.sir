            State: Ok
            Returns: branch

    Function
        Type: Function
        Role: Content
        Name: EditWrap
        Params: pathstr, target
        Returns: out

        Instruction
            Type: Instruction
            Role: Content
            Caption: Dots separate the range ends
            Op: Core.Lit
            Params: ".."
            Returns: dots

        Instruction
            Type: Instruction
            Role: Content
            Caption: Slash separator literal
            Op: Core.Lit
            Params: "/"
            Returns: slash

        Instruction
            Type: Instruction
            Role: Content
            Caption: Split the path into segments
            Op: Core.StrSplit
            Params: pathstr, slash
            Returns: segs

        Instruction
            Type: Instruction
            Role: Content
            Caption: Segment count bounds the parent walk
            Op: Core.ListLen
            Params: segs
            Returns: slen

        Instruction
            Type: Instruction
            Role: Content
            Caption: One literal for the range slot
            Op: Core.Lit
            Params: 1
            Returns: one

        Instruction
            Type: Instruction
            Role: Content
            Caption: Range lives in the last segment
            Op: Core.Sub
            Params: slen, one
            Returns: lastpos

        Instruction
            Type: Instruction
            Role: Content
            Caption: Read the range segment
            Op: Core.ListGet
            Params: segs, lastpos
            Returns: rangeseg

        Instruction
            Type: Instruction
            Role: Content
            Caption: Parent path drops the range
            Op: Ctrl.Call
            Params: EditTakeLines, segs, 0, lastpos
            Returns: parentsegs

        Instruction
            Type: Instruction
            Role: Content
            Caption: Function name heads the parent
            Op: Core.ListGet
            Params: parentsegs, 0
            Returns: fname

        Instruction
            Type: Instruction
            Role: Content
            Caption: Range start ends the split
            Op: Core.StrFind
            Params: rangeseg, dots, 0
            Returns: dotpos

        Instruction
            Type: Instruction
            Role: Content
            Caption: Range start text heads the dots
            Op: Core.StrSub
            Params: rangeseg, 0, dotpos
            Returns: fromtxt

        Instruction
            Type: Instruction
            Role: Content
            Caption: Dots length skips past the separator
            Op: Core.Lit
            Params: 2
            Returns: two

        Instruction
            Type: Instruction
            Role: Content
            Caption: Range end starts past the dots
            Op: Core.Add
            Params: dotpos, two
            Returns: topos

        Instruction
            Type: Instruction
            Role: Content
            Caption: Range end length is the remainder
            Op: Core.StrLen
            Params: rangeseg
            Returns: rangelen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Range end text follows the dots
            Op: Core.StrSub
            Params: rangeseg, topos, rangelen
            Returns: totxt

