                    Type: Branch
                    Role: Content
                    Caption: Separator only past the first
                    Condition: isFirst

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Parts unchanged for the first
                            Op: Core.Id
                            Params: cparts
                            Returns: cparts

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Comma code point, quotes cannot carry commas
                            Op: Core.Lit
                            Params: 44
                            Returns: commaCode

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Comma separator from its code point
                            Op: Core.Chr
                            Params: commaCode
                            Returns: commaMark

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Space literal for the csv gap
                            Op: Core.Lit
                            Params: " "
                            Returns: sp

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Comma plus space separator
                            Op: Core.StrConcat
                            Params: commaMark, sp
                            Returns: comma

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Keep the separator
                            Op: Core.ListPush
                            Params: cparts, comma
                            Returns: cparts

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the current capability
                    Op: Core.ListGet
                    Params: scaps, ci
                    Returns: cap

