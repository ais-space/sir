                    Type: Instruction
                    Role: Content
                    Caption: Advance the walk cursor
                    Op: Core.Add
                    Params: si, one
                    Returns: si

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: si, stop
                    Returns: scont

        Instruction
            Type: Instruction
            Role: Content
            Caption: Children carry the range
