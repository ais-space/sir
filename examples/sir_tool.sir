            Type: Instruction
            Role: Content
            Caption: Insert keeps the target then frags
            Op: Core.Eq
            Params: mode, insLit
            Returns: isIns

        Instruction
            Type: Instruction
            Role: Content
            Caption: Replace swaps the target for frags
            Op: Core.Eq
            Params: mode, repLit
            Returns: isRep

        Instruction
            Type: Instruction
            Role: Content
            Caption: One index literal for head math
            Op: Core.Lit
            Params: 1
            Returns: one

        Instruction
            Type: Instruction
            Role: Content
            Caption: Child count bounds the tail
            Op: Core.ListLen
            Params: kids
            Returns: klen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Head ends past the target for insert
            Op: Core.Add
            Params: idx, one
            Returns: insHead

        Branch
            Type: Branch
            Role: Content
            Caption: Head length by mode
            Condition: isIns

            TrueBlock
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Insert head keeps the target
                    Op: Core.Id
                    Params: insHead
                    Returns: headlen

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Insert tail starts past the target
                    Op: Core.Id
                    Params: insHead
                    Returns: tailpos

            FalseBlock
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Replace and delete head drops the target
                    Op: Core.Id
                    Params: idx
                    Returns: headlen

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Replace tail starts past the target
                    Op: Core.Add
                    Params: idx, one
                    Returns: tailpos

        Instruction
            Type: Instruction
            Role: Content
            Caption: Zero literal for the head start
            Op: Core.Lit
            Params: 0
            Returns: zero

        Instruction
            Type: Instruction
            Role: Content
            Caption: Take the head slice
            Op: Ctrl.Call
            Params: EditTakeLines, kids, zero, headlen
            Returns: head

        Instruction
            Type: Instruction
            Role: Content
            Caption: Tail length is the remainder
            Op: Core.Sub
            Params: klen, tailpos
            Returns: taillen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Take the tail slice
            Op: Ctrl.Call
            Params: EditTakeLines, kids, tailpos, taillen
            Returns: tail

        Instruction
            Type: Instruction
            Role: Content
            Caption: Spliced children accumulate here
            Op: Core.List
            Returns: out

        Instruction
            Type: Instruction
            Role: Content
            Caption: Head count bounds the copy
            Op: Core.ListLen
            Params: head
            Returns: hlen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Copy cursor starts at zero
            Op: Core.Lit
            Params: 0
            Returns: hi

        Instruction
            Type: Instruction
            Role: Content
            Caption: Enter while head items remain
            Op: Core.Lt
            Params: hi, hlen
            Returns: hcont

        Loop
            Type: Loop
            Role: Content
            Caption: Copy the head slice
            Condition: hcont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the current head item
                    Op: Core.ListGet
                    Params: head, hi
                    Returns: h

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Keep the head item
                    Op: Core.ListPush
                    Params: out, h
                    Returns: out

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Advance the copy cursor
                    Op: Core.Add
                    Params: hi, one
                    Returns: hi

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: hi, hlen
                    Returns: hcont

        Instruction
            Type: Instruction
            Role: Content
            Caption: Frags join for insert and replace, skip for delete
            Op: Core.Or
            Params: isRep, isIns
            Returns: joinFrags

        Branch
            Type: Branch
            Role: Content
            Caption: Copy frags or skip them
            Condition: joinFrags

            TrueBlock
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Frag count bounds the copy
                    Op: Core.ListLen
                    Params: frags
                    Returns: glen

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Frag cursor starts at zero
                    Op: Core.Lit
                    Params: 0
                    Returns: gi

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Enter while frags remain
                    Op: Core.Lt
                    Params: gi, glen
                    Returns: gcont

                Loop
                    Type: Loop
                    Role: Content
                    Caption: Copy the frag slice
                    Condition: gcont

                    Body
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Read the current frag
                            Op: Core.ListGet
                            Params: frags, gi
                            Returns: g

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Keep the frag
                            Op: Core.ListPush
                            Params: out, g
                            Returns: out

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Advance the frag cursor
                            Op: Core.Add
                            Params: gi, one
                            Returns: gi

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Re-evaluate the bound
                            Op: Core.Lt
                            Params: gi, glen
                            Returns: gcont

            FalseBlock
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Output unchanged past frags for delete
                    Op: Core.Id
                    Params: out
                    Returns: out

        Instruction
            Type: Instruction
            Role: Content
            Caption: Tail count bounds the copy
            Op: Core.ListLen
            Params: tail
            Returns: tlen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Tail cursor starts at zero
            Op: Core.Lit
            Params: 0
            Returns: ti

        Instruction
            Type: Instruction
            Role: Content
            Caption: Enter while tail items remain
            Op: Core.Lt
            Params: ti, tlen
            Returns: ticont

        Loop
            Type: Loop
            Role: Content
            Caption: Copy the tail slice
            Condition: ticont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the current tail item
                    Op: Core.ListGet
                    Params: tail, ti
                    Returns: t

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Keep the tail item
                    Op: Core.ListPush
                    Params: out, t
                    Returns: out

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Advance the tail cursor
                    Op: Core.Add
                    Params: ti, one
                    Returns: ti

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: ti, tlen
                    Returns: ticont

        Result
            Type: Result
            Role: Content
            Caption: Spliced children
            State: Ok
            Returns: out

    Function
        Type: Function
        Role: Content
        Name: EditRenderDoc
        Params: ast
        Returns: out

        Instruction
            Type: Instruction
            Role: Content
            Caption: Top-level blocks of the document
            Op: Core.MapGet
            Params: ast, "children"
            Returns: children

        Instruction
            Type: Instruction
            Role: Content
            Caption: Canonical lines accumulate here
            Op: Core.List
            Returns: lines

        Instruction
            Type: Instruction
            Role: Content
            Caption: Line separator for canonical output
            Op: Core.Chr
            Params: 10
            Returns: nl

        Instruction
            Type: Instruction
            Role: Content
            Caption: Top-level depth is zero
            Op: Core.Lit
            Params: 0
            Returns: zero

        Instruction
            Type: Instruction
            Role: Content
            Caption: Block count bounds the scan
            Op: Core.ListLen
            Params: children
            Returns: clen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Block cursor starts at zero
            Op: Core.Lit
            Params: 0
            Returns: ci

        Instruction
            Type: Instruction
            Role: Content
            Caption: Enter while blocks remain
            Op: Core.Lt
            Params: ci, clen
            Returns: ccont

        Loop
            Type: Loop
            Role: Content
            Caption: Serialize each top-level block
            Condition: ccont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the current block
                    Op: Core.ListGet
                    Params: children, ci
                    Returns: ch

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Serialize the block subtree
                    Op: Ctrl.Call
                    Params: FmtNode, ch, zero, nl, lines
                    Returns: lines

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Advance the block cursor
                    Op: Core.Add
                    Params: ci, 1
                    Returns: ci

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: ci, clen
                    Returns: ccont

        Instruction
            Type: Instruction
            Role: Content
            Caption: Single-pass join of canonical lines
            Op: Core.StrJoinParts
            Params: lines
            Returns: out

        Result
            Type: Result
            Role: Content
            Caption: Canonical document text
            State: Ok
            Returns: out

    Function
        Type: Function
        Role: Content
        Name: EditStructOp
        Params: mode, pathstr, target, payload
        Returns: out

        Instruction
            Type: Instruction
            Role: Content
            Caption: Parse the target document
            Op: Ctrl.Call
            Params: Parse, target
            Returns: ast

        Instruction
            Type: Instruction
            Role: Content
            Caption: Walk to the parent of the target
            Op: Ctrl.Call
            Params: EditWalkParent, ast, pathstr
            Returns: w

        Instruction
            Type: Instruction
            Role: Content
            Caption: Parent node of the target
            Op: Core.MapGet
            Params: w, "parent"
            Returns: parent

        Instruction
            Type: Instruction
            Role: Content
            Caption: Target index inside the parent
            Op: Core.MapGet
            Params: w, "idx"
            Returns: idx

        Instruction
            Type: Instruction
            Role: Content
            Caption: Children of the parent
            Op: Core.MapGet
            Params: parent, "children"
            Returns: kids

        Instruction
            Type: Instruction
            Role: Content
            Caption: Delete mode literal needs no payload
            Op: Core.Lit
            Params: "delete"
            Returns: delLit

        Instruction
            Type: Instruction
            Role: Content
            Caption: Delete skips the payload parse
            Op: Core.Eq
            Params: mode, delLit
            Returns: isDel

        Branch
            Type: Branch
            Role: Content
            Caption: Parse payload or keep empty frags
            Condition: isDel

            TrueBlock
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Empty frags for delete
                    Op: Core.List
                    Returns: frags

            FalseBlock
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Parse the payload fragment
                    Op: Ctrl.Call
                    Params: Parse, payload
                    Returns: past

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Module block of the fragment
                    Op: Ctrl.Call
                    Params: EditFindModule, past
                    Returns: pmod

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Fragment nodes join the splice
                    Op: Core.MapGet
                    Params: pmod, "children"
                    Returns: frags

        Instruction
            Type: Instruction
            Role: Content
            Caption: Splice frags into the children
            Op: Ctrl.Call
            Params: EditSplice, kids, idx, frags, mode
            Returns: spliced

        Instruction
            Type: Instruction
            Role: Content
            Caption: Store the spliced children back
            Op: Core.MapSetMut
            Params: parent, "children", spliced
            Returns: parent

        Instruction
            Type: Instruction
            Role: Content
            Caption: Render the edited document
            Op: Ctrl.Call
            Params: EditRenderDoc, ast
            Returns: out

        Result
            Type: Result
            Role: Content
            Caption: Edited canonical document
            State: Ok
            Returns: out

    Function
        Type: Function
        Role: Content
        Name: EditStructCall
        Params: structmode, structlen, raw, rawLen
        Returns: out

        Instruction
            Type: Instruction
            Role: Content
            Caption: Frame length without the prefix
            Op: Core.Sub
            Params: rawLen, structlen
            Returns: restlen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Frame text past the prefix
            Op: Core.StrSub
            Params: raw, structlen, restlen
            Returns: frame

        Instruction
            Type: Instruction
            Role: Content
            Caption: Parse the structural frame
            Op: Ctrl.Call
            Params: EditFrame, frame
            Returns: ef

        Instruction
            Type: Instruction
            Role: Content
            Caption: Structural path of the frame
            Op: Core.MapGet
            Params: ef, "path"
            Returns: epath

        Instruction
            Type: Instruction
            Role: Content
            Caption: Target text of the frame
            Op: Core.MapGet
            Params: ef, "target"
            Returns: etarget

        Instruction
            Type: Instruction
            Role: Content
            Caption: Payload text of the frame
            Op: Core.MapGet
            Params: ef, "payload"
            Returns: epayload

        Instruction
            Type: Instruction
            Role: Content
            Caption: Run the structural operation
            Op: Ctrl.Call
            Params: EditStructOp, structmode, epath, etarget, epayload
            Returns: out

        Result
            Type: Result
            Role: Content
            Caption: Structural call output
            State: Ok
            Returns: out

    Function
        Type: Function
        Role: Content
        Name: EditMove
        Params: pathstr, target
        Returns: out

        Instruction
            Type: Instruction
            Role: Content
            Caption: Arrow separates source and destination
            Op: Core.Lit
            Params: ">"
            Returns: arrow

        Instruction
            Type: Instruction
            Role: Content
            Caption: Split the move into source and destination
            Op: Core.StrSplit
            Params: pathstr, arrow
            Returns: ends

        Instruction
            Type: Instruction
            Role: Content
            Caption: Source path heads the move
            Op: Core.ListGet
            Params: ends, 0
            Returns: src

        Instruction
            Type: Instruction
            Role: Content
            Caption: One literal selects the destination
            Op: Core.Lit
            Params: 1
            Returns: one

        Instruction
            Type: Instruction
            Role: Content
            Caption: Destination path follows the move
            Op: Core.ListGet
            Params: ends, one
            Returns: dst

        Instruction
            Type: Instruction
            Role: Content
            Caption: Parse the target document
            Op: Ctrl.Call
            Params: Parse, target
            Returns: ast

        Instruction
            Type: Instruction
            Role: Content
            Caption: Walk to the source parent
            Op: Ctrl.Call
            Params: EditWalkParent, ast, src
            Returns: w1

        Instruction
            Type: Instruction
            Role: Content
            Caption: Source parent node
            Op: Core.MapGet
            Params: w1, "parent"
            Returns: parent1

        Instruction
            Type: Instruction
            Role: Content
            Caption: Source index inside the parent
            Op: Core.MapGet
            Params: w1, "idx"
            Returns: idx1

        Instruction
            Type: Instruction
            Role: Content
            Caption: Source siblings carry the node
            Op: Core.MapGet
            Params: parent1, "children"
            Returns: kids1

        Instruction
            Type: Instruction
            Role: Content
            Caption: Lift the moving node out
            Op: Core.ListGet
            Params: kids1, idx1
            Returns: moving

        Instruction
            Type: Instruction
            Role: Content
            Caption: Empty frags for the lifting splice
            Op: Core.List
            Returns: nofrags

        Instruction
            Type: Instruction
            Role: Content
            Caption: Delete mode literal lifts without frags
            Op: Core.Lit
            Params: "delete"
            Returns: delmode

        Instruction
            Type: Instruction
            Role: Content
            Caption: Splice the source out
            Op: Ctrl.Call
            Params: EditSplice, kids1, idx1, nofrags, delmode
            Returns: cut

        Instruction
            Type: Instruction
            Role: Content
            Caption: Store the cut children back
            Op: Core.MapSetMut
            Params: parent1, "children", cut
            Returns: parent1

        Instruction
            Type: Instruction
            Role: Content
            Caption: Walk to the destination parent past the cut
            Op: Ctrl.Call
            Params: EditWalkParent, ast, dst
            Returns: w2

        Instruction
            Type: Instruction
            Role: Content
            Caption: Destination parent node
            Op: Core.MapGet
            Params: w2, "parent"
            Returns: parent2

        Instruction
            Type: Instruction
            Role: Content
            Caption: Destination index inside the parent
            Op: Core.MapGet
            Params: w2, "idx"
            Returns: idx2

        Instruction
            Type: Instruction
            Role: Content
            Caption: Destination siblings take the node
            Op: Core.MapGet
            Params: parent2, "children"
            Returns: kids2

        Instruction
            Type: Instruction
            Role: Content
            Caption: Moving node rides alone
            Op: Core.List
            Returns: onefrag

        Instruction
            Type: Instruction
            Role: Content
            Caption: Keep the moving node
            Op: Core.ListPush
            Params: onefrag, moving
            Returns: onefrag

        Instruction
            Type: Instruction
            Role: Content
            Caption: Insert mode literal drops after the target
            Op: Core.Lit
            Params: "insert"
            Returns: insmode

        Instruction
            Type: Instruction
            Role: Content
            Caption: Splice the node after the destination
            Op: Ctrl.Call
            Params: EditSplice, kids2, idx2, onefrag, insmode
            Returns: spliced

        Instruction
            Type: Instruction
            Role: Content
            Caption: Store the spliced children back
            Op: Core.MapSetMut
            Params: parent2, "children", spliced
            Returns: parent2

        Instruction
            Type: Instruction
            Role: Content
            Caption: Render the moved document
            Op: Ctrl.Call
            Params: EditRenderDoc, ast
            Returns: out

        Result
            Type: Result
            Role: Content
            Caption: Moved canonical document
            State: Ok
            Returns: out

    Function
        Type: Function
        Role: Content
        Name: EditBranchWrap
        Params: nodes
        Returns: branch

        Instruction
            Type: Instruction
            Role: Content
            Caption: Branch block name literal
            Op: Core.Lit
            Params: "Branch"
            Returns: branchLit

        Instruction
            Type: Instruction
            Role: Content
            Caption: Property map of the branch
            Op: Core.Map
            Returns: props

        Instruction
            Type: Instruction
