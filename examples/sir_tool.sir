                    Type: Instruction
                    Role: Content
                    Caption: Keep the capability
                    Op: Core.ListPush
                    Params: cparts, cap
                    Returns: cparts

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Advance the merge cursor
                    Op: Core.Add
                    Params: ci, 1
                    Returns: ci

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: ci, slen
                    Returns: ccont

