    Function
        Type: Function
        Role: Content
        Name: EditFindFunc
        Params: mod, fname
        Returns: fn

        Instruction
            Type: Instruction
            Role: Content
            Caption: Empty function default fails loudly downstream
            Op: Core.Map
            Returns: fn

        Instruction
            Type: Instruction
            Role: Content
            Caption: Module children carry the functions
            Op: Core.MapGet
            Params: mod, "children"
            Returns: kids

        Instruction
            Type: Instruction
            Role: Content
            Caption: Child count bounds the scan
            Op: Core.ListLen
            Params: kids
            Returns: klen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Child cursor starts at zero
            Op: Core.Lit
            Params: 0
            Returns: ki

        Instruction
            Type: Instruction
            Role: Content
            Caption: Enter while children remain
            Op: Core.Lt
            Params: ki, klen
            Returns: kcont

        Loop
            Type: Loop
            Role: Content
            Caption: First name match wins
            Condition: kcont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the current child
                    Op: Core.ListGet
                    Params: kids, ki
                    Returns: ch

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Child block name selects functions
                    Op: Core.MapGet
                    Params: ch, "name"
                    Returns: cn

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Function block literal
                    Op: Core.Lit
                    Params: "Function"
                    Returns: fnLit

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Functions match by name
                    Op: Core.Eq
                    Params: cn, fnLit
                    Returns: isFunc

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Name check or pass through
                    Condition: isFunc

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Identity of the candidate
                            Op: Ctrl.Call
                            Params: EditFuncName, ch
                            Returns: nm

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Wanted function name
                            Op: Core.Eq
                            Params: nm, fname
                            Returns: isWanted

                        Branch
                            Type: Branch
                            Role: Content
                            Caption: Keep or pass through
                            Condition: isWanted

                            TrueBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Keep the wanted function
                                    Op: Core.Id
                                    Params: ch
                                    Returns: fn

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Stop past the function
                                    Op: Core.Add
                                    Params: ki, klen
                                    Returns: ki

                            FalseBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Function unchanged past mismatch
                                    Op: Core.Id
                                    Params: fn
                                    Returns: fn

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Advance the child cursor
                                    Op: Core.Add
                                    Params: ki, 1
                                    Returns: ki

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Function unchanged past blocks
                            Op: Core.Id
                            Params: fn
                            Returns: fn

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Advance the child cursor
                            Op: Core.Add
                            Params: ki, 1
                            Returns: ki

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: ki, klen
                    Returns: kcont

        Result
            Type: Result
            Role: Content
            Caption: Wanted function block
            State: Ok
            Returns: fn

    Function
        Type: Function
        Role: Content
        Name: EditWalkParent
        Params: ast, pathstr
        Returns: w

        Instruction
            Type: Instruction
            Role: Content
            Caption: Slash separator literal
            Op: Core.Lit
            Params: "/"
            Returns: slash

        Instruction
            Type: Instruction
            Role: Content
            Caption: Split the path into segments
            Op: Core.StrSplit
            Params: pathstr, slash
            Returns: segs

        Instruction
            Type: Instruction
            Role: Content
            Caption: Function name heads the path
            Op: Core.ListGet
            Params: segs, 0
            Returns: fname

        Instruction
            Type: Instruction
            Role: Content
            Caption: Module block of the document
            Op: Ctrl.Call
            Params: EditFindModule, ast
            Returns: mod

        Instruction
            Type: Instruction
            Role: Content
            Caption: Walk starts at the wanted function
            Op: Ctrl.Call
            Params: EditFindFunc, mod, fname
            Returns: node

        Instruction
            Type: Instruction
            Role: Content
            Caption: Segment count bounds the walk
            Op: Core.ListLen
            Params: segs
            Returns: slen

        Instruction
            Type: Instruction
            Role: Content
            Caption: Last segment is the target index
            Op: Core.Lit
            Params: 1
            Returns: one

        Instruction
            Type: Instruction
            Role: Content
            Caption: Parent walk stops before the last
            Op: Core.Sub
            Params: slen, one
            Returns: stop

        Instruction
            Type: Instruction
            Role: Content
            Caption: Walk cursor starts past the name
            Op: Core.Lit
            Params: 1
            Returns: si

        Instruction
            Type: Instruction
            Role: Content
            Caption: Enter while parent segments remain
            Op: Core.Lt
            Params: si, stop
            Returns: scont

        Loop
            Type: Loop
            Role: Content
            Caption: Descend one level per segment
            Condition: scont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Read the current segment
                    Op: Core.ListGet
                    Params: segs, si
                    Returns: seg

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Segment index as number
                    Op: Core.StrParse
                    Params: seg
                    Returns: idx

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Children of the current node
                    Op: Core.MapGet
                    Params: node, "children"
                    Returns: kids

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Descend into the indexed child
                    Op: Core.ListGet
                    Params: kids, idx
                    Returns: node

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Advance the walk cursor
                    Op: Core.Add
                    Params: si, one
                    Returns: si

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Re-evaluate the bound
                    Op: Core.Lt
                    Params: si, stop
                    Returns: scont

        Instruction
            Type: Instruction
            Role: Content
            Caption: Target index ends the path
            Op: Core.Sub
            Params: slen, one
            Returns: lastpos

        Instruction
            Type: Instruction
            Role: Content
            Caption: Read the target index segment
            Op: Core.ListGet
            Params: segs, lastpos
            Returns: lastseg

        Instruction
            Type: Instruction
            Role: Content
            Caption: Target index as number
            Op: Core.StrParse
            Params: lastseg
            Returns: idx

        Instruction
            Type: Instruction
            Role: Content
            Caption: Walk map carries parent and index
            Op: Core.Map
            Returns: w

        Instruction
            Type: Instruction
            Role: Content
            Caption: Keep the parent node
            Op: Core.MapSetMut
            Params: w, "parent", node
            Returns: w

        Instruction
            Type: Instruction
            Role: Content
            Caption: Keep the target index
            Op: Core.MapSetMut
            Params: w, "idx", idx
            Returns: w

        Result
            Type: Result
            Role: Content
            Caption: Parent plus target index
            State: Ok
            Returns: w

    Function
        Type: Function
        Role: Content
        Name: EditSplice
        Params: kids, idx, frags, mode
