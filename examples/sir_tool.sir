        Instruction
            Type: Instruction
            Role: Content
            Caption: Prefix cursor starts at zero
            Op: Core.Lit
            Params: 0
            Returns: pre

        Instruction
            Type: Instruction
            Role: Content
            Caption: One literal for the prefix step
            Op: Core.Lit
            Params: 1
            Returns: one

        Instruction
            Type: Instruction
            Role: Content
            Caption: Common prefix grows while lines match
            Op: Core.Lit
            Params: true
            Returns: pcont

        Loop
            Type: Loop
            Role: Content
            Caption: Extend the common prefix
            Condition: pcont

            Body
                Type: Section
                Role: Content

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Prefix inside the old text
                    Op: Core.Lt
                    Params: pre, olen
                    Returns: inOld

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Prefix inside the new text
                    Op: Core.Lt
                    Params: pre, nlen
                    Returns: inNew

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Both sides carry the prefix
                    Op: Core.And
                    Params: inOld, inNew
                    Returns: inBoth

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Compare or stop the prefix
                    Condition: inBoth

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Old line under the prefix
                            Op: Core.ListGet
                            Params: olds, pre
                            Returns: oline

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: New line under the prefix
                            Op: Core.ListGet
                            Params: news, pre
                            Returns: nline

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Lines match under the prefix
                            Op: Core.Eq
                            Params: oline, nline
                            Returns: same

                        Branch
                            Type: Branch
                            Role: Content
                            Caption: Grow or stop the prefix
                            Condition: same

                            TrueBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Grow the common prefix
                                    Op: Core.Add
                                    Params: pre, one
                                    Returns: pre

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Keep extending the prefix
                                    Op: Core.Id
                                    Params: pcont
                                    Returns: pcont

                            FalseBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Mismatch stops the prefix
                                    Op: Core.Lit
                                    Params: false
                                    Returns: pcont

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Edge stops the prefix
                            Op: Core.Lit
                            Params: false
                            Returns: pcont

        Instruction
            Type: Instruction
            Role: Content
            Caption: Suffix cursor starts at zero
            Op: Core.Lit
            Params: 0
            Returns: suf

        Instruction
            Type: Instruction
            Role: Content
            Caption: Common suffix grows while lines match
            Op: Core.Lit
            Params: true
            Returns: scont

        Loop
            Type: Loop
            Role: Content
            Caption: Extend the common suffix
