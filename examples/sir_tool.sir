                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Old index past the prefix
                    Op: Core.Sub
                    Params: oidx, one
                    Returns: opos

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Suffix stays past the prefix
                    Op: Core.Ge
                    Params: opos, pre
                    Returns: oldOk

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: New index back from the end
                    Op: Core.Sub
                    Params: nlen, suf
                    Returns: nidx

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: New index past the prefix
                    Op: Core.Sub
                    Params: nidx, one
                    Returns: npos

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Suffix stays past the prefix
                    Op: Core.Ge
                    Params: npos, pre
                    Returns: newOk

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Both sides carry the suffix
                    Op: Core.And
                    Params: oldOk, newOk
                    Returns: sBoth

                Branch
                    Type: Branch
                    Role: Content
                    Caption: Compare or stop the suffix
                    Condition: sBoth

                    TrueBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Old line under the suffix
                            Op: Core.ListGet
                            Params: olds, opos
                            Returns: oline

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: New line under the suffix
                            Op: Core.ListGet
                            Params: news, npos
                            Returns: nline

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Lines match under the suffix
                            Op: Core.Eq
                            Params: oline, nline
                            Returns: same

                        Branch
                            Type: Branch
                            Role: Content
                            Caption: Grow or stop the suffix
                            Condition: same

                            TrueBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Grow the common suffix
                                    Op: Core.Add
                                    Params: suf, one
                                    Returns: suf

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Keep extending the suffix
                                    Op: Core.Id
                                    Params: scont
                                    Returns: scont

                            FalseBlock
                                Type: Section
                                Role: Content

                                Instruction
                                    Type: Instruction
                                    Role: Content
                                    Caption: Mismatch stops the suffix
                                    Op: Core.Lit
                                    Params: false
                                    Returns: scont

                    FalseBlock
                        Type: Section
                        Role: Content

                        Instruction
                            Type: Instruction
                            Role: Content
                            Caption: Edge stops the suffix
                            Op: Core.Lit
                            Params: false
                            Returns: scont

