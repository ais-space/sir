                    Op: Ctrl.Call
                    Params: EditDirHead, full
                    Returns: cdir

                Instruction
                    Type: Instruction
                    Role: Content
                    Caption: Visit nested includes
                    Op: Ctrl.Call
                    Params: EditVisit, mod, cdir, base, estate
                    Returns: estate

        Result
            Type: Result
            Role: Content
            Caption: Estate with adopted file
            State: Ok
            Returns: estate

